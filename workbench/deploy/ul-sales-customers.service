[Unit]
Description=UL ERP customer directory API cache
After=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/ul-workbench/service
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=TZ=Asia/Shanghai
ExecStart=/usr/bin/flock --conflict-exit-code=0 -n /opt/ul-workbench/service/runtime/data/.web-browser-lane.lock /opt/ul-sales-runner/venv/bin/python /opt/ul-workbench/service/tools/sales_customer_directory_worker.py --runtime /opt/ul-workbench/service/runtime/data --vault /opt/ul-workbench/service/runtime/data/secrets/erp.json --profile 27056512834386351
UMask=0077
NoNewPrivileges=true
MemoryMax=128M
CPUQuota=50%
TimeoutStartSec=240s
PrivateTmp=true
InaccessiblePaths=/home/ulcodex/.codex /etc/ul-purchase /etc/ul-sales-web-worker
