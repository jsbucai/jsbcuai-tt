[Unit]
Description=Isolated unfinished purchase browser export trial
Wants=network-online.target
Requires=ul-purchase-display.service
After=network-online.target ul-purchase-display.service

[Service]
Type=oneshot
User=ulcollector
Group=ulcollector
WorkingDirectory=/opt/ul-purchase-collector
Environment=TZ=Asia/Shanghai
Environment=DISPLAY=:97
Environment=XAUTHORITY=/var/lib/ul-purchase-collector/display/.Xauthority
ExecStart=/opt/ul-purchase-collector/bin/run-trial.sh
UMask=0077
NoNewPrivileges=true
Restart=no
# Keep the same supervised browser alive while a person handles verification.
# No succeeding timer tick starts another copy of an active oneshot service.
TimeoutStartSec=infinity
TimeoutStopSec=30s
KillMode=control-group

