FROM ul-workbench:0.5.14
# Candidate only: website-confirmed import does not perform ERP readback.
USER root
COPY deploy/wheels-0.5.15 /tmp/wheels-0.5.15
RUN pip install --no-cache-dir --no-index --find-links=/tmp/wheels-0.5.15 --no-deps xlwt==1.3.0 xlutils==2.0.0 \
    && rm -rf /tmp/wheels-0.5.15
COPY --chown=10001:10001 service/core/sales_assistant.py /app/service/core/sales_assistant.py
COPY --chown=10001:10001 service/core/sales_source_parser.py /app/service/core/sales_source_parser.py
COPY --chown=10001:10001 service/core/sales_source_review.py /app/service/core/sales_source_review.py
COPY --chown=10001:10001 service/core/sales_history_matching.py /app/service/core/sales_history_matching.py
COPY --chown=10001:10001 service/core/sales_history_reference.py /app/service/core/sales_history_reference.py
COPY --chown=10001:10001 service/core/schema.py /app/service/core/schema.py
COPY --chown=10001:10001 service/core/importers.py /app/service/core/importers.py
COPY --chown=10001:10001 service/app.py /app/service/app.py
COPY --chown=10001:10001 service/run.py /app/service/run.py
COPY --chown=10001:10001 service/core/sales_document_extract.py /app/service/core/sales_document_extract.py
COPY --chown=10001:10001 service/core/sales_document_pipeline.py /app/service/core/sales_document_pipeline.py
COPY --chown=10001:10001 service/core/sales_web_queue.py /app/service/core/sales_web_queue.py
COPY --chown=10001:10001 service/core/unit_policy.py /app/service/core/unit_policy.py
COPY --chown=10001:10001 service/core/web_operations.py /app/service/core/web_operations.py
COPY --chown=10001:10001 service/core/procurement_assistant.py /app/service/core/procurement_assistant.py
COPY --chown=10001:10001 service/core/sales_web_import.py /app/service/core/sales_web_import.py
COPY --chown=10001:10001 service/core/sales_web_transport.py /app/service/core/sales_web_transport.py
COPY --chown=10001:10001 service/core/sales_web_readback.py /app/service/core/sales_web_readback.py
COPY --chown=10001:10001 service/core/sales_web_operation.py /app/service/core/sales_web_operation.py
COPY --chown=10001:10001 service/core/sales_trial_authorization.py /app/service/core/sales_trial_authorization.py
COPY --chown=10001:10001 service/core/sales_web_customer_preflight.py /app/service/core/sales_web_customer_preflight.py
COPY --chown=10001:10001 service/tools/sales_web_operation_worker.py /app/service/tools/sales_web_operation_worker.py
COPY --chown=10001:10001 service/tools/sales_web_host_preflight.py /app/service/tools/sales_web_host_preflight.py
USER 10001:10001
