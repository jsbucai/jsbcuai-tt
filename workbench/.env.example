# Safe defaults: data refresh works, ERP logistics writes cannot run.
UL_LOGISTICS_WRITE_ENABLED=0
UL_LOGISTICS_WRITE_SCOPE=
UL_LOGISTICS_WRITE_MAX_PER_JOB=0
UL_LOGISTICS_WRITE_ALLOWLIST=

# Pilot example (replace with reviewed complete order numbers):
# UL_LOGISTICS_WRITE_ENABLED=1
# UL_LOGISTICS_WRITE_SCOPE=bounded
# UL_LOGISTICS_WRITE_MAX_PER_JOB=3
# UL_LOGISTICS_WRITE_ALLOWLIST=ORDER#1,ORDER#2,ORDER#3

# After pilot acceptance, explicitly process every eligible difference in one
# manual update. Full mode rejects a simultaneous limit or allowlist:
# UL_LOGISTICS_WRITE_ENABLED=1
# UL_LOGISTICS_WRITE_SCOPE=all
# UL_LOGISTICS_WRITE_MAX_PER_JOB=0
# UL_LOGISTICS_WRITE_ALLOWLIST=
